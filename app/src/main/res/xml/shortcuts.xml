<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="generate_password"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="New Password"
        android:shortcutLongLabel="Generate a new password">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.keyfortress.app"
            android:targetClass="com.keyfortress.app.MainActivity"
            android:data="keyfortress://generator" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="open_vault"
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutShortLabel="Vault"
        android:shortcutLongLabel="Open your password vault">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.keyfortress.app"
            android:targetClass="com.keyfortress.app.MainActivity"
            android:data="keyfortress://vault" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
